{
  "name": "PotIO",
  "version": "1.1.0",
  "description": "Reliable zero-allocation potentiometer and joystick inputs for Arduino projects, with explicit sample validity and errors, strict or permissive calibration, independent filtering/shaping/slew stages, timing-gap protection, joystick geometry policies, continuous-wrap plausibility checks, durable step-change sequencing, rolling jitter tools, and ESP32 ADC helpers.",
  "keywords": "adc,analog,input,potentiometer,joystick,calibration,validity,deadzone,filter,ema,shaping,slew,continuous-pot,stepped-pot,esp32,esp32-s3,arduino",
  "license": "MIT",
  "authors": [
    {
      "name": "Little Man Builds (Darren Osborne)",
      "email": "littlemanbuilds@gmail.com",
      "maintainer": true
    }
  ],
  "homepage": "https://github.com/littlemanbuilds/PotIO",
  "repository": {
    "type": "git",
    "url": "https://github.com/littlemanbuilds/PotIO.git"
  },
  "frameworks": "arduino",
  "platforms": [
    "atmelavr",
    "atmelmegaavr",
    "atmelsam",
    "espressif32",
    "espressif8266",
    "raspberrypi",
    "ststm32",
    "teensy"
  ],
  "headers": [
    "PotIO.h"
  ],
  "build": {
    "includeDir": "src"
  },
  "examples": [
    "examples/01_LinearPotBasic/01_LinearPotBasic.ino",
    "examples/02_PotCalibration/02_PotCalibration.ino",
    "examples/03_ContinuousPotAdvanced/03_ContinuousPotAdvanced.ino",
    "examples/04_Joystick2DKY023/04_Joystick2DKY023.ino",
    "examples/05_ESP32ADC/05_ESP32ADC.ino",
    "examples/06_PotShaping/06_PotShaping.ino",
    "examples/07_PotSteering/07_PotSteering.ino",
    "examples/08_SteppedPotModeKnob/08_SteppedPotModeKnob.ino"
  ]
}
